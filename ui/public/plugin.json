{
  "contract": 1,
  "plugin": "auth",
  "entry": "/plugins/auth/remoteEntry.js",
  "panels": [],
  "pages": [
    {
      "id": "users",
      "path": "/admin/users",
      "title": {
        "zh-CN": "用户",
        "en": "Users"
      },
      "mount": {
        "kind": "module",
        "module": "auth/pages",
        "export": "UsersPage"
      }
    },
    {
      "id": "account",
      "path": "/me",
      "title": {
        "zh-CN": "我的账户",
        "en": "My account"
      },
      "mount": {
        "kind": "module",
        "module": "auth/pages",
        "export": "AccountPage"
      }
    },
    {
      "id": "user-detail",
      "path": "/admin/users/:id",
      "title": {
        "zh-CN": "用户详情",
        "en": "User detail"
      },
      "mount": {
        "kind": "module",
        "module": "auth/pages",
        "export": "UserDetailPage"
      }
    },
    {
      "id": "login",
      "path": "/login",
      "title": {
        "zh-CN": "登录",
        "en": "Sign in"
      },
      "mount": {
        "kind": "module",
        "module": "auth/pages",
        "export": "LoginPage"
      }
    },
    {
      "id": "register",
      "path": "/register",
      "title": {
        "zh-CN": "注册",
        "en": "Register"
      },
      "mount": {
        "kind": "module",
        "module": "auth/pages",
        "export": "RegisterPage"
      }
    },
    {
      "id": "change-password",
      "path": "/change-password",
      "title": {
        "zh-CN": "修改密码",
        "en": "Change password"
      },
      "mount": {
        "kind": "module",
        "module": "auth/pages",
        "export": "ChangePasswordPage"
      }
    }
  ]
}
